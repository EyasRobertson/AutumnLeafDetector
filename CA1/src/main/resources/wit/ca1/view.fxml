<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<Pane fx:id="basePane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: lightblue;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="wit.ca1.LeafController">
    <children>
        <Button layoutX="85.0" layoutY="18.0" onAction="#handleChooseImage" prefHeight="25.0" prefWidth="177.0" style="-fx-border-color: black; -fx-background-color: white; -fx-font-weight: bold; -fx-graphic-text-gap: 10;" text="Choose Image" />
        <Label layoutX="124.0" layoutY="226.0" style="-fx-font-size: 14; -fx-font-weight: bold;" text="Original Image" />
        <ImageView fx:id="imageView" fitWidth="300.0" layoutX="20.0" layoutY="250.0" pickOnBounds="true" preserveRatio="true" />
        <ImageView fx:id="hsbView" fitWidth="300.0" layoutX="20.0" layoutY="250.0" pickOnBounds="true" preserveRatio="true" />
        <ImageView fx:id="boxView" fitWidth="300.0" layoutX="20.0" layoutY="250.0" onMouseClicked="#handleMouseClickOGImage" pickOnBounds="true" preserveRatio="true" />

        <Label layoutX="451.0" layoutY="226.0" style="-fx-font-size: 14; -fx-font-weight: bold;" text="Altered Image" />
        <ImageView fx:id="altImageView" fitWidth="300.0" layoutX="350.0" layoutY="250.0" onMouseClicked="#handleColouringClick" onMouseMoved="#handleMouseHover" pickOnBounds="true" preserveRatio="true" />
        <ImageView fx:id="numImageView" fitWidth="300.0" layoutX="350.0" layoutY="250.0" onMouseClicked="#handleColouringClick" onMouseMoved="#handleMouseHover" pickOnBounds="true" preserveRatio="true" />

        <Button layoutX="358.0" layoutY="18.0" mnemonicParsing="false" onAction="#getMaxAndMin" style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: blue;" text="Box Them" />
        <Button layoutX="446.0" layoutY="18.0" mnemonicParsing="false" onAction="#makeColourful" style="-fx-background-color: white; -fx-text-fill: purple;" text="Colourful" />
        <Button layoutX="372.0" layoutY="81.0" mnemonicParsing="false" onAction="#noiseReduction" style="-fx-background-color: white;" text="Noise Reducer" />
        <Button layoutX="375.0" layoutY="129.0" mnemonicParsing="false" onAction="#leafEstimate" style="-fx-background-color: white;" text="Leaf Estimate" />
        <Button layoutX="526.0" layoutY="18.0" mnemonicParsing="false" onAction="#labelClusters" style="-fx-text-fill: red; -fx-background-color: white;" text="Label Clusters" />
        <Button layoutX="198.0" layoutY="53.0" mnemonicParsing="false" onAction="#blackAndWhite" style="-fx-background-color: black; -fx-text-fill: white;" text="Black and White" />
        <Button layoutX="56.0" layoutY="53.0" mnemonicParsing="false" onAction="#adjustHSB" style="-fx-background-color: white;" text="Alter Original" />
        <Label fx:id="leafEstLabel" layoutX="471.0" layoutY="133.0" prefHeight="17.0" prefWidth="200.0" style="-fx-border-color: grey;" text="Leaf/Cluster estimate ______" />
        <Label fx:id="clusterSizeLabel" layoutX="418.0" layoutY="204.0" prefHeight="17.0" prefWidth="140.0" />

        <Slider fx:id="noiseRed" blockIncrement="1.0" layoutX="471.0" layoutY="73.0" majorTickUnit="1.0" max="10.0" min="2" minorTickCount="0" showTickLabels="true" showTickMarks="true" snapToTicks="true" value="5.0" />
        <Slider fx:id="hueSlider" blockIncrement="1.0" layoutX="85.0" layoutY="133.0" majorTickUnit="1.0" max="10.0" min="-10.0" minorTickCount="0" prefHeight="37.0" prefWidth="251.0" showTickLabels="true" showTickMarks="true" snapToTicks="true" value="0.0" />
        <Slider fx:id="satSlider" blockIncrement="1.0" layoutX="85.0" layoutY="83.0" majorTickUnit="1.0" max="10.0" min="-10.0" minorTickCount="0" prefHeight="37.0" prefWidth="251.0" showTickLabels="true" showTickMarks="true" snapToTicks="true" value="0.0" />
        <Slider fx:id="briSlider" blockIncrement="1.0" layoutX="80.0" layoutY="181.0" majorTickUnit="1.0" max="10.0" min="-10.0" minorTickCount="0" prefHeight="37.0" prefWidth="261.0" showTickLabels="true" showTickMarks="true" snapToTicks="true" value="0.0" />

        <Label fx:id="hueLab" layoutX="41.0" layoutY="93.0" prefHeight="17.0" prefWidth="30.0" text="Hue" />
        <Label fx:id="satLab" layoutX="20.0" layoutY="133.0" prefHeight="17.0" prefWidth="56.0" text="Saturation" />
        <Label fx:id="briLab" layoutX="20.0" layoutY="180.0" prefHeight="17.0" prefWidth="56.0" text="Brightness" />
    </children>
</Pane>
